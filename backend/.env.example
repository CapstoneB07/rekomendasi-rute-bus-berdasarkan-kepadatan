# ---------------------------------------------------------------------------
# Salin file ini ke `.env` dan isi kredensial.
#
# Tuning TIDAK lagi perlu diisi di sini: nilai terukur sudah menjadi default
# di `services/config.py` (2026-10-07):
#   wait=50, eta=60, weight=0.95, safe=0.0, scope 8 koridor  ->  54,17%
#
# Hanya isi baris di bawah bila ingin MENIMPA default tersebut (mis. untuk
# menjalankan tangga pembanding dengan nilai konservatif lama:
#   wait=20, eta=45, weight=0.85, safe=0.35, scope 1-5  ->  ~24,5%).
#
# Kredensial (SUPABASE_*) WAJIB diisi dan TIDAK boleh di-commit.
# ---------------------------------------------------------------------------

# --- Override opsional (biarkan komentar untuk memakai default kode) ---
#BUS_MAX_EXTRA_WAIT_MENIT=50
#BUS_MAX_ETA_MENIT=60
#BUS_SCORE_DENSITY_WEIGHT=0.95
#BUS_SAFE_NEXT_DENSITY_THRESHOLD=0
#SCOPED_KORIDOR=1,2,3,4,5,8,9,12
#HALTE_ALIAS_RADIUS_METER=200

# Batas tampilan load factor (c251 Eq 4.20 memakai clamp 1.0 untuk re-ranking).
# Naikkan hanya untuk pengukuran/analisis, bukan untuk produksi.
#LOAD_FACTOR_OUTPUT_CAP=1.0

# Kredensial — WAJIB diisi, jangan di-commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
