# ---------------------------------------------------------------------------
# Konfigurasi terukur untuk target sukses (lihat catatan:
#   Cap - Keputusan Target c501 (D_route & Trade-off Tunggu)).
# Diukur 2026-10-07: 104/192 = 54,17% pada konfigurasi di bawah, dengan
# ongkos +12,63 menit tunggu tambahan (21,37 mnt pada baris menang).
#
# Salin file ini ke `.env` untuk mereproduksi angka tersebut. Jika dibiarkan
# komentar, sistem memakai default konservatif (~24,5%).
#
# Nilai-nilai ini BUKAN rahasia dan boleh ada di repo. Hanya kredensial
# (SUPABASE_*) yang tidak boleh di-commit.
# ---------------------------------------------------------------------------

# Bus-layer tunables (Algoritma 2) — dibaca saat import services.config.
# Default konservatif (dulu satu-satunya nilai):
#   wait=20, eta=45, weight=0.85, safe=0.35  ->  ~24,5%
BUS_MAX_EXTRA_WAIT_MENIT=50
BUS_MAX_ETA_MENIT=60
BUS_SCORE_DENSITY_WEIGHT=0.95
# 0 = matikan aturan "bus tercepat sudah cukup nyaman". Aturan ini TAMBAHAN
# repo, bukan dari c251; mematikannya menyumbang ~25% dari kemenangan.
BUS_SAFE_NEXT_DENSITY_THRESHOLD=0

# Cakupan koridor. Default: 1,2,3,4,5 (5 koridor).
# 8 koridor = scope yang dipakai untuk mengukur 54,17%.
SCOPED_KORIDOR=1,2,3,4,5,8,9,12

# Radius alias halte platform (meter), masalah #12.
# 80 = nilai lama (8 pasangan kembar 83-165 m tidak ter-alias -> 404).
# 200 = nilai sekarang; 123 grup nama kembar, maksimum 164,9 m.
HALTE_ALIAS_RADIUS_METER=200

# Batas tampilan load factor (c251 Eq 4.20 memakai clamp 1.0 untuk re-ranking).
# Naikkan hanya untuk pengukuran/analisis, bukan untuk produksi.
#LOAD_FACTOR_OUTPUT_CAP=1.0

# Kredensial — WAJIB diisi, jangan di-commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
